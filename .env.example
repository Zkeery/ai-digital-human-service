# 服务
APP_HOST=127.0.0.1
APP_PORT=8050
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db

# 试点入口（仅 1 个）
PILOT_ENTRY_ID=entry_pilot_001
AGENT_ENABLED=0
RAG_ENABLED=0
RAG_TIMEOUT_SECONDS=0.5

# 模型（验收前由产品经理填写真实值；勿提交 .env）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MOCK=1
LLM_TIMEOUT_SECONDS=8
MONTHLY_BUDGET_CNY=500
HISTORY_LIMIT=10
ROOM_ACTIVE_LIMIT=30
SYNC_HOLD_MS=2000
